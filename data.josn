    },
    {
        "id": 283,
        "username": "Mister\ud83d\ude0e",
        "message": "\u062a\u0648 \u06c1\u0645 \u0641\u0631\u0634\u062a\u06c1 \u0635\u0641\u062a \u0644\u0648\u06af \u062a\u0648 \u0641\u0648\u0631\u0627 \u0627\u0644\u0644\u0651\u06c1 \u06a9\u06d2 \u0633\u0627\u0645\u0646\u06d2 \u0627\u0644\u062a\u062c\u0627 \u06a9\u0631\u062f\u06cc\u06ba \u06af\u06d2 \u06a9\u06c1 \u06cc\u0627 \u0627\u0644\u0644\u0651\u06c1 \u0627\u0633\u06d2 \u0645\u0639\u0627\u0641 \u06a9\u0631\u062f\u06d2 \u06cc\u06c1 \u0628\u06d2\u0686\u0627\u0631\u06c1 \u0634\u0631\u0645\u0646\u062f\u06c1 \u06c1\u06d2 \u0627\u067e\u0646\u06d2 \u06a9\u0626\u06d2 \u067e\u0631",
        "image": "",
        "time": "10/05/2026 09:27 PM"
    },
