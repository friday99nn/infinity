    },
    {
        "id": 280,
        "username": "Mister\ud83d\ude0e",
        "message": "\u06a9\u06cc\u0648\u06ba \u06a9\u06c1 \u06c1\u0645 \u062c\u0633 \u06a9\u0648 \u0631\u0628 \u0645\u0627\u0646\u062a\u06d2 \u06c1\u06cc\u06ba \u060c \u0627\u0633 \u06a9\u0627 \u06c1\u0645 \u0633\u06d2 \u0628\u0633 \u0627\u06cc\u06a9 \u06c1\u06cc \u0645\u0637\u0627\u0644\u0628\u06c1 \u06c1\u0648\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0627\u0633 \u06a9\u06d2 \u0639\u0644\u0627\u0648\u06c1 \u06a9\u0648 \u06a9\u0648 \u0646\u0627 \u0645\u0627\u0646\u0627 \u062c\u0627\u0626\u06d2",
        "image": "",
