    },
    {
        "id": 282,
        "username": "Mister\ud83d\ude0e",
        "message": "\u06a9\u06c1 \u0645\u062c\u06be \u0633\u06d2 \u062c\u0648 \u0633\u062c\u062f\u06d2 \u0645\u06cc\u06ba \u06a9\u0648\u062a\u0627\u06c1\u06cc \u06c1\u0648\u0626\u06cc \u062a\u06be\u06cc \u0627\u0633 \u06a9\u06cc \u0645\u0639\u0627\u0641\u06c1 \u062f\u06d2 \u062f\u06cc\u06ba",
