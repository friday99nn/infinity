    },
    {
        "id": 281,
        "username": "Mister\ud83d\ude0e",
        "message": "\u0627\u06af\u0631 \u0622\u062c \u0634\u06cc\u0637\u0627\u0646 \u0622\u067e \u0633\u06d2 \u0622\u06a9\u0631 \u06a9\u06c1\u06c1 \u062f\u06d2 \u06a9\u06c1 \u0622\u067e \u0627\u067e\u0646\u06d2 \u0631\u0628 \u0633\u06d2 \u0645\u06cc\u0631\u06cc \u0633\u0641\u0627\u0631\u0634 \u06a9\u0631\u06cc\u06ba",
